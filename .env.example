# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-secret-key

# Newsletter (Resend — plan gratis: https://resend.com)
# 1. Crea tu cuenta en Resend y verifica tu dominio (camelloonline.com)
# 2. Copia tu API key
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Camello Online <newsletter@camelloonline.com>

# Protección opcional del cron (pon un valor aleatorio largo)
CRON_SECRET=pon-aqui-un-secreto-largo
